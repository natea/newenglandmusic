# typically something like
# postgresql://USER@localhost:5432/DB
# so in my (Greg's) case:
# DATABASE_URL='postgresql://g@localhost:5432/nycnoise'
# i.e. 'g' is my computer user name and 'nycnoise' is the database I created in Postgres
DATABASE_URL='postgresql://postgres@localhost:5432/nycnoise'

# set it to some random/secret value.
# easy way to get a random value: on Linux/Macs, run `uuidgen` and use that uuid
DJANGO_SECRET_KEY='...........'

# leave as is
ALLOWED_HOSTS='localhost'

# leave as is
DJANGO_SETTINGS_MODULE='nycnoise.settings.dev'

# ok to leave blank
RC_DEVELOPER_INTERNAL_TOKEN=''
PROD_INTERNAL_API_SERVER='https://nyc-noise.com/'

# set to true to add the debug toolbar.
# this is only intended to be used on dev (with DEBUG=True)
DEBUG_TOOLBAR_ENABLE="false"

# similarly, set to true to enable pyinstrument profiling.
# profiling will only happen when user is logged in as a superuser
PYINSTRUMENT_ENABLE="false"

ENABLE_EMAILING_JESSICA_ON_EVENT_SUBMISSION="false"

# for fetch_events: claude extracts events from venue pages that have no structured data.
# ok to leave blank -- ai extraction is then skipped
ANTHROPIC_API_KEY=''

# for match_ticketmaster_venues and fetch_events: the "Consumer Key" of an app at
# https://developer-acct.ticketmaster.com/user/login (the consumer secret isn't needed).
# ok to leave blank -- ticketmaster venues are then skipped
TICKETMASTER_API_KEY=''

# for match_eventbrite_organizers and fetch_events: an eventbrite account's private token,
# from https://www.eventbrite.com/platform/api-keys. it's sent as a bearer token.
# ok to leave blank -- eventbrite venues are then skipped
EVENTBRITE_API_KEY=''

# for match_spotify_artists and the listing's spotify play buttons: the client id and secret
# of an app at https://developer.spotify.com/dashboard (tick "Web API"). the app's owner needs
# spotify premium. ok to leave blank -- no play buttons are shown then
SPOTIFY_CLIENT_ID=''
SPOTIFY_CLIENT_SECRET=''

# for match_apple_music_artists and the listing's apple music play buttons: a musickit key
# from https://developer.apple.com/account (an apple developer program membership): the
# team id (Membership page), the key's id, and the .p8 file's whole text (newlines may be
# written as \n). see PRODUCTION.md. ok to leave blank -- no apple buttons are shown then
APPLE_MUSIC_TEAM_ID=''
APPLE_MUSIC_KEY_ID=''
APPLE_MUSIC_PRIVATE_KEY=''
# "true" shows the apple music buttons; leave it off until the matches are reviewed
APPLE_MUSIC_PREVIEWS='false'

# the email the api clients' user agent gives (musicbrainz, wikidata, last.fm, the census
# downloads), so a service can reach us before blocking us. ok to leave blank -- the user
# agent then gives only the site's address
API_CONTACT_EMAIL=''

# for match_youtube_artists and the listing's youtube play buttons: a google cloud key with
# only "YouTube Data API v3" enabled, and restricted to it (see PRODUCTION.md).
# ok to leave blank -- no youtube buttons are found then
YOUTUBE_API_KEY=''
# "true" shows the youtube buttons; leave it off until the matches are reviewed
YOUTUBE_PREVIEWS='false'

# for lookup_venue_places: a google maps platform key. in the google cloud console,
# restrict it to the "Places API (New)" and cap its daily quota.
# ok to leave blank -- venues then keep the sheet's (town-level) coordinates
GOOGLE_PLACES_API_KEY=''

# for sync_venues_from_gsheets on a server: the json key of a google cloud service account
# that the sheet is shared with (see PRODUCTION.md), all on one line. leave it out
# locally -- the sheet is then read with the gog cli.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# analytics, both optional -- leave blank and no tracker is loaded (e.g. locally).
# a google analytics 4 measurement id, like G-XXXXXXXXXX
# the site's name and the calendar feeds (/calendar.ics, and each event's ICAL download;
# see PRODUCTION.md). SITE_NAME names the feeds' calendars ("New England Music: Vermont")
# and the "install" banner on iphones ("INSTALL NEW ENGLAND MUSIC"). blank: New England Music
SITE_NAME=''
# UID_DOMAIN is the part after "@" in each show's calendar ID (event-123@newenglandmusic),
# which lets calendar apps update a show rather than add it again. blank: newenglandmusic.
# set it once and leave it: changing it after people subscribe shows them every show twice
UID_DOMAIN=''

GOOGLE_ANALYTICS_ID=''
# a goatcounter site code: the "mysite" in https://mysite.goatcounter.com
GOATCOUNTER_CODE=''

# the site's public address, used in share links. leave as is locally.
SITE_URL='http://localhost:8001'
# shown on the submit-event form and sent event submissions. ok to leave blank.
CONTACT_EMAIL=''
# the sender address for outgoing email (event-submission notifications).
DEFAULT_FROM_EMAIL=''

# for the home page's maps: a protomaps api key from https://protomaps.com/account
# (free for non-commercial use; restrict it to your site's domains there).
# ok to leave blank -- the "show map" links are then hidden
PROTOMAPS_API_KEY=''
# where the maps start before zooming to the day's venues. blank means new england.
MAP_CENTER_LATITUDE=''
MAP_CENTER_LONGITUDE=''
MAP_ZOOM=''
