#!/usr/bin/env python3
"""check a triage, clarify or spec run's result before the intentable bridge sees it.

usage: check-intentable-result <triage|clarify> [path]
       check-intentable-result spec [--draft | --sketches]

triage and clarify: reads .intentable/result.json (or path) and exits 0 when
the bridge would accept it and it follows the issue-triage rules; otherwise
prints one plain reason and exits 1, which fails the run (the workflows set
on_failure="exit").

spec: reads .intentable/draft.json and the change it names, following the
issue-proposals rules. --draft checks the draft and any sketches' safety,
writing nothing; --sketches also requires the sketches; with no flag it is the
run's last step: it checks everything again, copies the review summary to
.intentable/review.md, and writes .intentable/result.json.

A draft with "revision": true revises a change that existed before the run
(the bridge's revision run, on the change's draft branch). It may narrow the
sketches to one, and with "scope": "sketches" it may change only the sketches
and the design's "Sketches" section, compared with .intentable/base.
"""

import json
import re
import shutil
import subprocess
import sys
from html.parser import HTMLParser
from pathlib import Path

# the intentable bridge's issue labels, copied from bridge/src/labels.ts in
# natea/intentable; a change to those labels must change this list too
GROUPS = {
    "type": ["type:bug", "type:feature", "type:refactor", "type:chore", "type:spike"],
    "clarity": [f"clarity:{n}" for n in range(1, 6)],
    "risk": [f"risk:{n}" for n in range(1, 6)],
    "blast": [f"blast:{n}" for n in range(1, 6)],
    "size": [f"size:{s}" for s in ("XS", "S", "M", "L", "XL")],
}
LATER_STAGES = [f"P{n}" for n in range(1, 6)] + ["needs-design", "ai-shippable"]
ISSUE_LABELS = [label for labels in GROUPS.values() for label in labels] + LATER_STAGES
STATES = ["triage", "needs-info", "spec-review", "needs-design", "building", "preview-ready", "merged", "parked"]

# what each workflow may give
ALLOWED_STATES = {"triage": ["spec-review", "needs-info", "parked"], "clarify": ["spec-review", "needs-info"]}
MAX_MESSAGE = 2000
# how every spec-review message ends, so the person knows what happens next
SPEC_REVIEW_ENDING = "Next, this will be written up as a proposal for Nate to review before anything is built."
# a GitHub mention: @login at the start of a word, so an email address isn't one
MENTION = re.compile(r"(?<![\w.@])@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?")


class Refused(Exception):
    pass


def group_of(label):
    return next((name for name, labels in GROUPS.items() if label in labels), None)


def check(workflow, text):
    """the reason a result is refused, raised as Refused; returns the parsed result"""
    try:
        result = json.loads(text)
    except ValueError:
        raise Refused("the result isn't JSON")
    if not isinstance(result, dict):
        raise Refused("the result isn't a JSON object of labels, state and message")

    labels = result.get("labels")
    if not isinstance(labels, list) or not all(isinstance(label, str) for label in labels):
        raise Refused("labels must be a list of label names")
    for label in labels:
        if label.startswith("state:"):
            raise Refused(f"{label} is a state label; give the state as state instead")
        if label not in ISSUE_LABELS:
            raise Refused(f"{label} isn't one of the issue labels")
        if label in LATER_STAGES:
            raise Refused(f"{label} is for a later stage to set")

    counts = {name: sum(1 for label in labels if group_of(label) == name) for name in GROUPS}
    required = list(GROUPS) if workflow == "triage" else ["clarity"]
    for name in GROUPS:
        if counts[name] > 1:
            raise Refused(f"more than one {name} label")
        if name in required and counts[name] == 0:
            raise Refused(f"no {name} label")

    state = result.get("state")
    if state not in STATES:
        raise Refused(f"{state!r} isn't a state")
    if state not in ALLOWED_STATES[workflow]:
        raise Refused(f"{workflow} can't move an issue to {state}")

    clarity = int(next(label for label in labels if group_of(label) == "clarity").split(":")[1])
    if state == "spec-review" and clarity < 4:
        raise Refused(f"clarity {clarity} needs a question, not spec review")
    if state == "needs-info" and clarity >= 4:
        raise Refused(f"clarity {clarity} goes to spec review, not another question")

    message = result.get("message")
    if not isinstance(message, str) or not message.strip():
        raise Refused("the message is missing")
    if state == "needs-info" and message.count("?") != 1:
        raise Refused("ask one question: the message must have exactly one question mark")
    if state == "spec-review" and not message.rstrip().endswith(SPEC_REVIEW_ENDING):
        raise Refused(f"a spec-review message must end with: {SPEC_REVIEW_ENDING}")
    if MENTION.search(message):
        raise Refused("messages mention no one")
    if len(message) > MAX_MESSAGE:
        raise Refused(f"the message is too long: {len(message)} characters, at most {MAX_MESSAGE}")
    return result


# --- spec: the draft, the change it names, and its sketches ---

INTENTABLE = Path(".intentable")
CHANGES = Path("openspec/changes")
# a change name, the same set the bridge accepts
CHANGE_NAME = re.compile(r"[a-z0-9]+(-[a-z0-9]+)*")
MAX_NAME = 60
# the bridge commits at most 100 files; this stays well under it
MAX_FILES = 90
# Fabro's record of a run's files marks anything larger as truncated, and the bridge then refuses the draft
MAX_FILE_BYTES = 256 * 1024
MAX_FILE_LINES = 20000
# path segments Fabro skips in its records of a run, so a file under one could go missing
SKIPPED = {".git", "node_modules", "target", "dist", ".venv", "venv", ".cache", ".pnpm-store", ".npm", ".next",
           "__pycache__", ".tox", ".pytest_cache"}
SKETCHES = ("a.html", "b.html", "c.html")
ARCHIVE_DATE = re.compile(r"\d{4}-\d{2}-\d{2}-")


def read_json(path, what):
    if not path.is_file():
        raise Refused(f"{what} is missing: no {path}")
    try:
        return json.loads(path.read_text())
    except ValueError:
        raise Refused(f"{what} isn't JSON")


def check_message(message):
    if not isinstance(message, str) or not message.strip():
        raise Refused("the message is missing")
    if MENTION.search(message):
        raise Refused("messages mention no one")
    if len(message) > MAX_MESSAGE:
        raise Refused(f"the message is too long: {len(message)} characters, at most {MAX_MESSAGE}")


def existing_changes():
    """the changes that existed before the agent ran, archive dates removed"""
    record = INTENTABLE / "existing-changes.txt"
    if not record.is_file():
        raise Refused("the record of existing changes is missing")
    return {ARCHIVE_DATE.sub("", line.strip(), count=1) for line in record.read_text().splitlines() if line.strip()}


def new_change_folders():
    """change folders that weren't there before the agent ran"""
    if not CHANGES.is_dir():
        return []
    existing = existing_changes()
    return [p.name for p in sorted(CHANGES.iterdir()) if p.is_dir() and p.name != "archive" and p.name not in existing]


def check_draft(draft):
    """the draft's rules; returns (change or None, labels, state)"""
    if not isinstance(draft, dict):
        raise Refused("the draft isn't a JSON object")
    labels = draft.get("labels", [])
    if not isinstance(labels, list) or not all(isinstance(label, str) for label in labels):
        raise Refused("labels must be a list of label names")
    state = draft.get("state")
    revision = draft.get("revision", False)
    if revision not in (True, False):
        raise Refused("revision must be true when given")
    scope = draft.get("scope")
    if scope is not None and (not revision or scope != "sketches"):
        raise Refused("scope may only be \"sketches\", in a revision")
    if revision and state is not None:
        raise Refused("a revision can't send the issue back; answer the feedback in the message instead")
    recorded = INTENTABLE / "route.json"
    if recorded.is_file():
        route = json.loads(recorded.read_text())
        if sorted(route.get("labels", [])) != sorted(labels):
            raise Refused("the labels changed after routing; revise may not change them")
        if route.get("change") != draft.get("change"):
            raise Refused("the change was renamed after routing; revise may not rename it")
    check_message(draft.get("message"))
    if state == "needs-info":
        if draft.get("change") is not None:
            raise Refused("a needs-info draft names no change")
        if len(labels) != 1 or labels[0] not in [f"clarity:{n}" for n in (1, 2, 3)]:
            raise Refused("a needs-info draft gives exactly one label, clarity:1 to clarity:3")
        if draft["message"].count("?") != 1:
            raise Refused("ask one question: the message must have exactly one question mark")
        stray = new_change_folders()
        if stray:
            raise Refused(f"a needs-info draft writes no change, but {stray[0]} is new")
        return None, labels, state
    if state is not None:
        raise Refused(f"{state!r} isn't a state a spec draft may give; only needs-info")
    for label in labels:
        if label != "needs-design":
            raise Refused(f"{label} isn't a label a proposal may give; only needs-design")
    change = draft.get("change")
    if not isinstance(change, str) or len(change) > MAX_NAME or not CHANGE_NAME.fullmatch(change):
        raise Refused(f"{change!r} isn't a change name: lowercase letters, digits and single hyphens, at most {MAX_NAME}")
    if not (CHANGES / change).is_dir():
        raise Refused(f"the change folder is missing: no {CHANGES / change}")
    if revision:
        if change not in existing_changes():
            raise Refused(f"a revision revises an existing change, but {change} didn't exist before the run")
        stray = new_change_folders()
        if stray:
            raise Refused(f"a revision writes no new change, but {stray[0]} is new")
    elif change in existing_changes():
        raise Refused(f"the change {change} already exists")
    return change, labels, state


def change_files(change):
    """every file of the change, relative to its folder, after the bounds"""
    folder = CHANGES / change
    files = []
    for path in sorted(folder.rglob("*")):
        relative = path.relative_to(folder)
        if path.is_symlink():
            raise Refused(f"{relative} is a link, not a file")
        if path.is_dir():
            continue
        if SKIPPED & set(relative.parts):
            raise Refused(f"{relative} is under a folder Fabro skips when collecting")
        data = path.read_bytes()
        try:
            data.decode("utf-8")
        except UnicodeDecodeError:
            raise Refused(f"{relative} isn't UTF-8 text")
        if len(data) > MAX_FILE_BYTES or data.count(b"\n") > MAX_FILE_LINES:
            raise Refused(f"{relative} is too large: at most {MAX_FILE_BYTES} bytes and {MAX_FILE_LINES} lines")
        files.append(relative.as_posix())
    if len(files) > MAX_FILES:
        raise Refused(f"the change has {len(files)} files, at most {MAX_FILES}")
    return files


def validate(change):
    done = subprocess.run(["openspec", "validate", change, "--strict"], capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        lines = [line for line in (done.stdout + done.stderr).splitlines() if line.strip()]
        raise Refused(f"openspec validate failed: {lines[0] if lines else 'no output'}")


# what a sketch may contain: static markup and inline styling, nothing that runs or calls out
SAFE_ELEMENTS = {
    "html", "head", "body", "title", "style", "meta", "main", "header", "footer", "nav", "section", "article",
    "aside", "div", "span", "p", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol", "li", "dl", "dt", "dd", "table",
    "thead", "tbody", "tfoot", "tr", "th", "td", "caption", "colgroup", "col", "a", "img", "figure", "figcaption",
    "strong", "em", "b", "i", "u", "s", "small", "mark", "code", "pre", "blockquote", "br", "hr", "time", "abbr",
    "sup", "sub", "button", "label", "kbd", "samp", "var", "q", "cite", "dfn", "del", "ins", "wbr", "address",
}
SAFE_ATTRIBUTES = {
    "class", "id", "style", "title", "lang", "dir", "role", "alt", "width", "height", "colspan", "rowspan",
    "scope", "span", "datetime", "type", "charset", "name", "content", "href", "src",
}
CSS_URL = re.compile(r"url\(\s*['\"]?([^'\")]*)", re.IGNORECASE)


def css_problem(css):
    lowered = css.lower()
    if "\\" in css:
        return "a backslash escape in CSS"
    for banned in ("@import", "@font-face", "@namespace", "image-set(", "cross-fade(", "element(", "src(", "expression(",
                   "javascript:", "-moz-binding"):
        if banned in lowered:
            return f"{banned} in CSS"
    # IE's behavior property, not safe ones like scroll-behavior
    if re.search(r"(?<![-\w])behavior\s*:", lowered):
        return "behavior: in CSS"
    for url in CSS_URL.findall(css):
        if not (url.startswith("#") or url.lower().startswith("data:image/")):
            return f"the CSS URL {url!r}"
    return None


class SketchChecker(HTMLParser):
    """records the first thing in a sketch that isn't on the allowlist"""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.problem = None
        self.in_style = False

    def refuse(self, problem):
        self.problem = self.problem or problem

    def handle_starttag(self, tag, attrs):
        if tag not in SAFE_ELEMENTS:
            return self.refuse(f"the element <{tag}>")
        values = dict(attrs)
        if tag == "meta":
            charset_only = set(values) == {"charset"} and (values["charset"] or "").lower() == "utf-8"
            viewport = set(values) == {"name", "content"} and values["name"] == "viewport"
            if not (charset_only or viewport):
                return self.refuse("a <meta> other than charset=utf-8 or viewport")
        for name, value in attrs:
            value = (value or "").strip()
            if name.startswith("aria-") or name.startswith("data-"):
                continue
            if name not in SAFE_ATTRIBUTES:
                return self.refuse(f"the attribute {name}= on <{tag}>")
            if name == "href" and not value.startswith("#"):
                return self.refuse(f"the link {value!r}")
            if name == "src" and not (tag == "img" and value.lower().startswith("data:image/")):
                return self.refuse(f"the source {value!r}")
            if css_problem(value):
                return self.refuse(f"{css_problem(value)} in {name}=")
            if "javascript:" in value.lower().replace(" ", ""):
                return self.refuse(f"a javascript: URL in {name}=")
        self.in_style = tag == "style"

    def handle_startendtag(self, tag, attrs):
        # a browser ignores the slash on <style/>, and reads what follows as CSS
        if tag == "style":
            return self.refuse("a self-closed <style>")
        self.handle_starttag(tag, attrs)
        self.in_style = False

    def handle_endtag(self, tag):
        self.in_style = False

    def handle_data(self, data):
        if self.in_style and "<" in data:
            self.refuse("markup inside <style>")
        if self.in_style and css_problem(data):
            self.refuse(css_problem(data))

    def handle_pi(self, data):
        self.refuse("a processing instruction")

    def unknown_decl(self, data):
        self.refuse("an unknown declaration")

    def handle_comment(self, data):
        self.refuse("an HTML comment")


# Python and browsers disagree on odd comments and declarations (<!-->, --!>), so none is allowed
ONLY_DOCTYPE = re.compile(r"<!(?!doctype\s+html\s*>)", re.IGNORECASE)


def sketch_problem(text):
    if ONLY_DOCTYPE.search(text) or "--!>" in text:
        return "a comment or declaration other than the doctype"
    if "http-equiv" in text.lower():
        return "http-equiv, which the page's policy can't stop"
    checker = SketchChecker()
    checker.feed(text)
    checker.close()
    return checker.problem


def check_options(path, names=SKETCHES):
    """each sketch's entry in options.json, with the label, thesis and risk the issue comment shows"""
    try:
        options = json.loads(path.read_text())
    except ValueError:
        raise Refused("sketches/options.json isn't JSON")
    if not isinstance(options, list) or not all(isinstance(option, dict) for option in options):
        raise Refused("sketches/options.json must be a list of options")
    by_file = {option.get("file"): option for option in options}
    for name in names:
        if name not in by_file:
            raise Refused(f"sketches/options.json has no entry for {name}")
        for field in ("label", "thesis", "risk"):
            value = by_file[name].get(field)
            if not isinstance(value, str) or not value.strip():
                raise Refused(f"sketches/options.json has no {field} for {name}")


def sketch_set(folder, revision):
    """the sketches a draft must have: all three, or for a revision that narrowed to one, that one"""
    present = [name for name in SKETCHES if (folder / name).is_file()]
    if revision and len(present) == 1:
        return tuple(present)
    if present and len(present) < len(SKETCHES):
        missing = next(name for name in SKETCHES if name not in present)
        raise Refused(f"the sketch sketches/{missing} is missing: a new draft has three options and a narrowed revision one")
    return SKETCHES


def check_sketches(change, required, revision=False):
    """the sketches' safety; with required, also that the set and options.json are there and linked"""
    folder = CHANGES / change / "sketches"
    if required:
        names = sketch_set(folder, revision)
        for name in names + ("options.json",):
            if not (folder / name).is_file():
                raise Refused(f"the sketch sketches/{name} is missing")
        check_options(folder / "options.json", names)
        design = (CHANGES / change / "design.md").read_text() if (CHANGES / change / "design.md").is_file() else ""
        for name in names:
            if f"sketches/{name}" not in design:
                raise Refused(f"design.md doesn't link sketches/{name}")
    if folder.is_dir():
        for sketch in sorted(folder.glob("*.html")):
            problem = sketch_problem(sketch.read_text())
            if problem:
                raise Refused(f"sketches/{sketch.name} isn't safe to publish: {problem}")


SKETCHES_HEADING = re.compile(r"^(#+)\s+Sketches\s*$", re.MULTILINE)


def without_sketches_section(text):
    """design.md with its "Sketches" section cut out, up to the next heading at its level or above"""
    found = SKETCHES_HEADING.search(text)
    if not found:
        return text
    level = len(found.group(1))
    rest = text[found.end():]
    after = re.search(rf"^#{{1,{level}}}\s", rest, re.MULTILINE)
    return text[:found.start()] + (rest[after.start():] if after else "")


def git(*args):
    done = subprocess.run(["git", *args], capture_output=True, text=True, timeout=60)
    if done.returncode != 0:
        raise Refused(f"git {args[0]} failed: {(done.stderr or done.stdout).strip()[:200]}")
    return done.stdout


def check_scope(change):
    """a sketches-only revision changes nothing but sketches/ and the design's "Sketches" section"""
    base_file = INTENTABLE / "base"
    if not base_file.is_file():
        raise Refused("the record of the run's base commit is missing")
    base = base_file.read_text().strip()
    folder = f"{CHANGES.as_posix()}/{change}"
    changed = set(git("diff", "--name-only", base, "--", folder).split())
    changed |= set(git("ls-files", "--others", "--exclude-standard", "--", folder).split())
    for path in sorted(changed):
        relative = path[len(folder) + 1:]
        if relative.startswith("sketches/"):
            continue
        if relative == "design.md":
            before = git("show", f"{base}:{path}") if git("ls-tree", base, "--", path).strip() else ""
            after = Path(path).read_text() if Path(path).is_file() else ""
            if without_sketches_section(before) == without_sketches_section(after):
                continue
            raise Refused("a sketches-only revision changed design.md outside its \"Sketches\" section")
        raise Refused(f"a sketches-only revision changed {relative}; after G2 only the sketches may change")


def spec(mode):
    """the spec checks; with no mode, also writes the run's result and the summary"""
    change, labels, state = check_draft(read_json(INTENTABLE / "draft.json", "the draft"))
    draft = json.loads((INTENTABLE / "draft.json").read_text())
    revision = draft.get("revision") is True
    if change is not None:
        files = change_files(change)
        validate(change)
        # a revision never passes the --sketches step, so its draft checks hold it to its sketch set
        required = mode == "--sketches" or ((mode is None or revision) and "needs-design" in labels)
        check_sketches(change, required=required, revision=revision)
        if draft.get("scope") == "sketches":
            check_scope(change)
    if mode is not None:
        return
    if change is None:
        result = {"labels": labels, "state": state, "message": draft["message"]}
    else:
        outcome_file = INTENTABLE / "reviews" / "outcome"
        outcome = outcome_file.read_text().strip() if outcome_file.is_file() else ""
        if outcome not in ("passed", "not-passed"):
            raise Refused("the review's outcome is missing")
        summary = INTENTABLE / "reviews" / "summary.md"
        if not summary.is_file():
            raise Refused("the review summary is missing")
        shutil.copyfile(summary, INTENTABLE / "review.md")
        result = {
            "change": change, "labels": labels, "state": None, "message": draft["message"],
            "reviewed": outcome, "files": files,
        }
        if revision:
            result["revision"] = True
    (INTENTABLE / "result.json").write_text(json.dumps(result, indent=2) + "\n")


def main(argv):
    if len(argv) >= 2 and argv[1] == "spec":
        if len(argv) > 3 or (len(argv) == 3 and argv[2] not in ("--draft", "--sketches")):
            print("usage: check-intentable-result spec [--draft | --sketches]", file=sys.stderr)
            return 2
        try:
            spec(argv[2] if len(argv) == 3 else None)
        except Refused as reason:
            print(f"spec draft refused: {reason}", file=sys.stderr)
            return 1
        print("spec draft accepted")
        return 0
    if len(argv) not in (2, 3) or argv[1] not in ALLOWED_STATES:
        print("usage: check-intentable-result <triage|clarify> [path] | spec [--draft | --sketches]", file=sys.stderr)
        return 2
    path = Path(argv[2] if len(argv) == 3 else ".intentable/result.json")
    if not path.is_file():
        print(f"the result is missing: no {path}", file=sys.stderr)
        return 1
    try:
        check(argv[1], path.read_text())
    except Refused as reason:
        print(f"result refused: {reason}", file=sys.stderr)
        return 1
    print(f"{argv[1]} result accepted")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
