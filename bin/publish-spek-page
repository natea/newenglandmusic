#!/usr/bin/env python3
"""place a built Spek page in the GitHub Pages site folder for a branch.

usage: publish-spek-page <branch> <page> <site> [thumbnails]
       publish-spek-page --thumbnails <branch> <out>

main goes to <site>/index.html and change/<name> to
<site>/changes/<name>/index.html; any other branch is refused and nothing is
written. It always writes <site>/.nojekyll and replaces only the one
index.html, so publishing main never touches the change pages.

For change/<name> it also copies that change's sketches, if any: each
regular file directly in openspec/changes/<name>/sketches/ (read from the
current directory, the branch's checkout) whose name ends in .html, to
<site>/changes/<name>/sketches/, replacing that folder whole. Each published
sketch starts with a Content-Security-Policy meta tag, so a browser refuses
scripts, outside resources and form posts on the Pages domain. A policy can't
stop a meta refresh, so a sketch with http-equiv isn't published. Any
<sketch>.png in the [thumbnails] folder goes beside its sketch.

--thumbnails renders each sketch to <out>/<sketch>.png, in a job of its own: it
needs no token and Chrome gets no network, because a sketch is untrusted. A
thumbnail that can't be made is only reported.
"""

import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# a change name: no slashes, no leading dot or dash, nothing a shell could read as code
NAME = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")


def target(branch):
    """the page's path inside the site folder, or None for a branch that gets no page"""
    if branch == "main":
        return Path("index.html")
    if branch.startswith("change/"):
        name = branch[len("change/") :]
        if NAME.fullmatch(name):
            return Path("changes") / name / "index.html"
    return None


# what a published sketch may do: inline styles and data: images, nothing else
POLICY = (
    "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; "
    "img-src data:; form-action 'none'; base-uri 'none'\">"
)
DOCTYPE = re.compile(r"\A(\ufeff?\s*<!doctype[^>]*>)", re.IGNORECASE)


def with_policy(html):
    """the sketch with the policy first, after any doctype, before anything that could run"""
    found = DOCTYPE.match(html)
    if found:
        return found.group(1) + POLICY + html[found.end() :]
    return POLICY + html


def sketches_of(name):
    """the change's sketches that may be published: regular files, nothing a policy can't hold"""
    source = Path("openspec") / "changes" / name / "sketches"
    found = []
    for sketch in sorted(source.glob("*.html")) if source.is_dir() else []:
        if not sketch.is_file() or sketch.is_symlink():
            continue
        try:
            text = sketch.read_text()
        except UnicodeDecodeError:
            print(f"not publishing {sketch.name}: it isn't UTF-8")
            continue
        if "http-equiv" in text.lower():
            print(f"not publishing {sketch.name}: it has http-equiv")
            continue
        found.append(sketch)
    return found


def publish_sketches(name, site, thumbnails=None):
    """replaces the change's published sketches with the checkout's"""
    destination = site / "changes" / name / "sketches"
    shutil.rmtree(destination, ignore_errors=True)
    for sketch in sketches_of(name):
        destination.mkdir(parents=True, exist_ok=True)
        (destination / sketch.name).write_text(with_policy(sketch.read_text()))
        png = Path(thumbnails) / sketch.with_suffix(".png").name if thumbnails else None
        if png and png.is_file() and not png.is_symlink():
            shutil.copyfile(png, destination / png.name)


def change_name(branch):
    relative = target(branch)
    return branch[len("change/") :] if relative is not None and branch.startswith("change/") else None


def render_thumbnails(branch, out):
    """half-size screenshots of the sketches with their policy; Chrome can reach nothing"""
    name = change_name(branch)
    chrome = next(filter(None, map(shutil.which, ("google-chrome", "google-chrome-stable", "chromium"))), None)
    if name is None or chrome is None:
        print(f"no thumbnails: {'no change for this branch' if name is None else 'no Chrome on PATH'}")
        return 0
    out = Path(out)
    out.mkdir(parents=True, exist_ok=True)
    for sketch in sketches_of(name):
        with tempfile.TemporaryDirectory() as scratch:
            copy = Path(scratch) / sketch.name
            copy.write_text(with_policy(sketch.read_text()))
            try:
                subprocess.run(
                    [
                        chrome, "--headless=new", "--no-sandbox", "--disable-gpu", "--hide-scrollbars", "--no-first-run",
                        "--host-resolver-rules=MAP * ~NOTFOUND", f"--user-data-dir={scratch}/profile",
                        "--window-size=1440,900", "--force-device-scale-factor=0.5",
                        f"--screenshot={(out / sketch.name).resolve().with_suffix('.png')}", copy.as_uri(),
                    ],
                    check=True, capture_output=True, timeout=60,
                )
            except (OSError, subprocess.SubprocessError) as error:
                print(f"no thumbnail for {sketch.name}: {error}")
    return 0


def main(argv):
    if len(argv) == 4 and argv[1] == "--thumbnails":
        return render_thumbnails(argv[2], argv[3])
    if len(argv) not in (4, 5):
        print("usage: publish-spek-page <branch> <page> <site> [thumbnails] | --thumbnails <branch> <out>", file=sys.stderr)
        return 2
    branch, page, site = argv[1], Path(argv[2]), Path(argv[3])
    thumbnails = argv[4] if len(argv) == 5 else None
    relative = target(branch)
    if relative is None:
        print(f"no page for branch {branch!r}: only main and change/<name> are published", file=sys.stderr)
        return 1
    if not page.is_file():
        print(f"no built page at {page}", file=sys.stderr)
        return 1
    destination = site / relative
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(page, destination)
    if branch.startswith("change/"):
        publish_sketches(branch[len("change/") :], site, thumbnails)
    (site / ".nojekyll").touch()
    print(f"published {branch} at {relative.parent.as_posix() + '/' if relative.parent != Path('.') else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
