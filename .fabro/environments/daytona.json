{
  "id": "daytona",
  "provider": "daytona",
  "cwd": null,
  "image": {
    "docker": null,
    "dockerfile": null
  },
  "resources": {
    "cpu": 2,
    "memory": "4GB",
    "disk": "10GB"
  },
  "network": {
    "mode": "allow_all",
    "allow": []
  },
  "lifecycle": {
    "preserve": false,
    "stop_on_terminal": true,
    "auto_stop": "30m"
  },
  "labels": {
    "repo": "natea/newenglandmusic"
  },
  "env": {
    "CLAUDE_CODE_OAUTH_TOKEN": "{{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}",
    "ANTHROPIC_API_KEY": ""
  }
}
