digraph Build {
    graph [goal="The build stage of the intentable loop for one change Nate confirmed on the New England Music Project site"]
    rankdir=LR
    on_failure="exit"

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // What the site's tests need, as CI has it (.github/workflows/django.yml):
    // pinned agent tools, Python 3.11 through uv, a local Postgres of 14 or
    // later, Chromium for the browser test and the compiled CSS. It writes CI's
    // test environment and the commit the run targeted under .intentable/, and
    // fails if it changed a tracked file, so its checkpoint commit stays empty.
    setup [
        label="Set up the tools and the test database",
        shape=parallelogram,
        timeout="30m",
        script="
set -eu
if [ $(id -u) = 0 ]; then SUDO=''; PG='runuser -u postgres --'; else SUDO='sudo -n'; PG='sudo -n -u postgres'; fi
npm install -g --prefix /usr/local @anthropic-ai/claude-code@2.1.316 @agentclientprotocol/claude-agent-acp@0.99.1 @fission-ai/openspec@1.16.0
curl -LsSf https://astral.sh/uv/0.9.7/install.sh | sh
export PATH=$HOME/.local/bin:$PATH
uv python install 3.11
uv venv --python 3.11 venv
uv pip install --python venv/bin/python -r requirements-dev.txt
$SUDO apt-get update -qq
$SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq postgresql
$SUDO service postgresql start
$PG psql -q -c 'ALTER USER postgres WITH PASSWORD $$postgres$$'
$PG createdb djtesting
VERSION=$($PG psql -tA -c 'SHOW server_version_num')
if [ $VERSION -lt 140000 ]; then echo 'the site needs Postgres 14 or later; this sandbox has' $VERSION; exit 1; fi
venv/bin/python -m playwright install --with-deps chromium
mkdir -p .intentable
cat > .intentable/test.env <<'EOT'
DATABASE_URL=postgres://postgres:postgres@localhost:5432/djtesting
DJANGO_SECRET_KEY=F5ADD2EE-40F5-4F4E-911C-4714E7CA873F
ALLOWED_HOSTS=localhost
DJANGO_SETTINGS_MODULE=nycnoise.settings.test
RC_DEVELOPER_INTERNAL_TOKEN=0xdeadbeef
PROD_INTERNAL_API_SERVER=https://nyc-noise.com
DEBUG_TOOLBAR_ENABLE=false
PYINSTRUMENT_ENABLE=false
ENABLE_EMAILING_JESSICA_ON_EVENT_SUBMISSION=false
EOT
set -a; . ./.intentable/test.env; set +a
venv/bin/python manage.py compilescss
git rev-parse HEAD > .intentable/start
if git status --porcelain | grep -q .; then echo 'setup changed tracked files:'; git status --porcelain; exit 1; fi
"
    ]

    // applies the change's task groups, one green commit each (apply.md)
    apply [
        label="Apply the change (Claude Code, ACP)",
        type="agent",
        backend="acp",
        acp.command="claude-agent-acp",
        prompt="@apply.md"
    ]

    // the refactoring pass, at most one commit (refactor.md)
    refactor [
        label="Refactor (Claude Code, ACP)",
        type="agent",
        backend="acp",
        acp.command="claude-agent-acp",
        prompt="@refactor.md"
    ]

    // sends a stopped build straight to finish, so no refactoring runs on unfinished work
    route [
        label="Route on the outcome",
        shape=parallelogram,
        output_schema="routing",
        language="python",
        script="
import json
from pathlib import Path
try:
    outcome = json.loads(Path('.intentable/build.json').read_text()).get('outcome')
except (OSError, ValueError, AttributeError):
    outcome = None
print(json.dumps({'context_updates': {'route': 'refactor' if outcome == 'complete' else 'finish'}}))
"
    ]

    // the final check: the record, the commits, the tasks and the suite; then the result
    finish [
        label="Check the build and write the result",
        shape=parallelogram,
        timeout="60m",
        language="python",
        script="
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# no backslashes or double quotes anywhere in this script: line breaks and tabs come from chr()
NL = chr(10)
TAB = chr(9)
SPACE = '[ ' + TAB + NL + chr(13) + ']'
WORD = 'A-Za-z0-9_'

# closing keywords as GitHub reads them: any case, an optional colon, one or more references;
# keep in step with CLOSING in intentable's bridge/src/builds.ts
KEYWORD = '(?<![' + WORD + '])(close[sd]?|fix(e[sd])?|resolve[sd]?)(?![' + WORD + '])'
REF = '(https?://github[.]com/[' + WORD + '.-]+/[' + WORD + '.-]+/(issues|pull)/[0-9]+|[' + WORD + '.-]+/[' + WORD + '.-]+#[0-9]+|#[0-9]+)'
CLOSING = re.compile(KEYWORD + SPACE + '*:?' + SPACE + '*' + REF, re.IGNORECASE)

# the message rules of bin/check-intentable-result, except that a mention inside backticks is allowed
MENTION = re.compile('(?<![' + WORD + '.@])@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?')
MAX_MESSAGE = 2000
CHANGE_NAME = re.compile('[a-z0-9]+(-[a-z0-9]+)*')
TASK = re.compile('^ *- [[]([ xX])[]] ([0-9]+[.][0-9]+)', re.MULTILINE)


def fail(reason):
    print('the build broke a rule: ' + reason)
    sys.exit(1)


def git(*args):
    return subprocess.run(['git', *args], capture_output=True, text=True, check=True).stdout


def protected(path):
    return path.startswith('.github/') or path.startswith('.fabro/') or path == 'bin/publish-spek-page'


# the agent's record
record_path = Path('.intentable/build.json')
if not record_path.exists():
    fail('the agent wrote no record, .intentable/build.json')
try:
    record = json.loads(record_path.read_text())
except ValueError:
    fail('the record is not JSON')
if not isinstance(record, dict):
    fail('the record is not a JSON object')
outcome = record.get('outcome')
if outcome not in ('complete', 'stopped'):
    fail('the outcome must be complete or stopped, not ' + repr(outcome))
change = record.get('change')
if not isinstance(change, str) or not CHANGE_NAME.fullmatch(change) or not Path('openspec/changes', change).is_dir():
    fail('the record names no change folder under openspec/changes/: ' + repr(change))
message = record.get('message')
if not isinstance(message, str) or not message.strip():
    fail('the message for the issue is empty')
if len(message) > MAX_MESSAGE:
    fail('the message is ' + str(len(message)) + ' characters, at most ' + str(MAX_MESSAGE))
if MENTION.search(re.sub('`[^`]*`', '', message)):
    fail('the message mentions someone; put code names in backticks')
left = record.get('left_for_people', [])
if not isinstance(left, list) or not all(isinstance(t, dict) and isinstance(t.get('task'), str) and isinstance(t.get('reason'), str) for t in left):
    fail('left_for_people must be a list of tasks, each with a reason')

# the change's tasks
tasks_text = Path('openspec/changes', change, 'tasks.md').read_text() if Path('openspec/changes', change, 'tasks.md').exists() else ''
unticked = [m.group(2) for m in TASK.finditer(tasks_text) if m.group(1) == ' ']
for t in left:
    if t['task'] not in unticked:
        fail('task ' + t['task'] + ' is listed as needing a person, but it is ticked or does not exist')

# the commits since the commit the run targeted
start = Path('.intentable/start').read_text().strip()
work = 0
for line in git('rev-list', '--reverse', '--parents', start + '..HEAD').splitlines():
    sha, *parents = line.split()
    short = sha[:7]
    if len(parents) > 1:
        fail('commit ' + short + ' is a merge')
    full = git('log', '-1', '--format=%B', sha)
    subject = full.splitlines()[0] if full.strip() else ''
    changes = [row.split(TAB) for row in git('diff-tree', '--no-commit-id', '-r', '-M', '--name-status', sha).splitlines() if row]
    if subject.startswith('fabro('):
        if changes:
            fail('commit ' + short + ' is a Fabro checkpoint holding work an agent left uncommitted')
        continue
    work += 1
    if CLOSING.search(full):
        fail('commit ' + short + ' has a closing keyword in its message, which would close an issue when merged')
    for row in changes:
        for path in row[1:]:
            if protected(path):
                fail('commit ' + short + ' touches ' + path + ', which a build may not change')

if outcome == 'complete':
    if work == 0:
        fail('a complete build made no commit')
    listed = [t['task'] for t in left]
    for task in unticked:
        if task not in listed:
            fail('task ' + task + ' is unticked in a complete build')

# the suite, with the test environment setup wrote
env = dict(os.environ)
env_file = Path('.intentable/test.env')
if env_file.exists():
    for row in env_file.read_text().splitlines():
        if '=' in row and not row.startswith('#'):
            key, value = row.split('=', 1)
            env[key] = value
command = os.environ.get('BUILD_TEST_COMMAND', 'venv/bin/python manage.py test')
if subprocess.run(command, shell=True, env=env).returncode != 0:
    fail('the suite fails')

# the result, for the bridge
Path('.intentable/result.json').write_text(json.dumps({'labels': [], 'state': None, 'message': message, 'outcome': outcome, 'change': change}) + NL)
summary_path = Path('.intentable/summary.md')
summary = summary_path.read_text().strip() if summary_path.exists() else ''
if left:
    items = NL.join('- Task ' + t['task'] + ': ' + t['reason'] for t in left)
    summary = (summary + NL + NL if summary else '') + '## Left for a person' + NL + NL + items
if summary:
    Path('.intentable/pull-request.md').write_text(summary + NL)

# nothing of finish's own may reach a commit
if git('status', '--porcelain').strip():
    fail('the finish step left tracked files changed')
print('build checked: ' + outcome)
"
    ]

    start -> setup -> apply -> route
    route -> refactor [condition="context.route=refactor"]
    route -> finish
    refactor -> finish -> exit
}
