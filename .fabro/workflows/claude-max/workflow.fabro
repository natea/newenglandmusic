digraph ClaudeMax {
    graph [goal="Smoke-test Claude Code on the Max subscription in a Daytona sandbox"]
    rankdir=LR
    on_failure="exit"

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    install [
        label="Install Claude Code",
        shape=parallelogram,
        script="npm install -g --prefix /usr/local @anthropic-ai/claude-code@2.1.316 @agentclientprotocol/claude-agent-acp@0.99.1"
    ]

    work [
        label="Claude Code (ACP)",
        type="agent",
        backend="acp",
        acp.command="claude-agent-acp",
        prompt="Create a file called hello-claude-max.txt in the workspace root containing exactly: hello from claude max in daytona"
    ]

    start -> install -> work -> exit
}
